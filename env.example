# =============================================================================
# TalentPulse AI - Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="TalentPulse AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Supabase Configuration (Required)
# -----------------------------------------------------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="your-project-url.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Database Direct Connection (for migrations)
DATABASE_URL=""

# -----------------------------------------------------------------------------
# AI Services Configuration
# -----------------------------------------------------------------------------
# OpenAI (for resume parsing and matching)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4-turbo-preview"
OPENAI_MAX_TOKENS=4000

# Anthropic Claude (alternative AI provider)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# AI Configuration
AI_PROVIDER="openai" # Options: "openai" or "anthropic"
AI_RESUME_PARSING_ENABLED=true
AI_CANDIDATE_MATCHING_ENABLED=true
AI_FRAUD_DETECTION_ENABLED=true

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
# For production, use services like SendGrid, AWS SES, or Resend
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="noreply@talentpulse.ai"
SMTP_FROM_NAME="TalentPulse AI"

# Email Service Provider (alternative to SMTP)
# RESEND_API_KEY="re_..." # If using Resend
# SENDGRID_API_KEY="SG..." # If using SendGrid

# -----------------------------------------------------------------------------
# File Storage Configuration
# -----------------------------------------------------------------------------
# Supabase Storage (default)
NEXT_PUBLIC_STORAGE_BUCKET="resumes"
MAX_FILE_SIZE=10485760 # 10MB in bytes
ALLOWED_FILE_TYPES="application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain"

# Alternative: AWS S3
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="talentpulse-resumes"

# -----------------------------------------------------------------------------
# LinkedIn Integration (Optional)
# -----------------------------------------------------------------------------
# Get from: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID="your-client-id"
LINKEDIN_CLIENT_SECRET="your-client-secret"
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/linkedin/callback"
LINKEDIN_ENABLED=false

# -----------------------------------------------------------------------------
# Authentication Configuration
# -----------------------------------------------------------------------------
# JWT Settings
JWT_SECRET="your-random-secret-key-min-32-chars"
JWT_EXPIRATION="7d"
REFRESH_TOKEN_EXPIRATION="30d"

# Session Configuration
SESSION_SECRET="your-session-secret-min-32-chars"
SESSION_MAX_AGE=604800 # 7 days in seconds

# Password Requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# -----------------------------------------------------------------------------
# Rate Limiting & Security
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW=900000 # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ENABLED=true

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,https://yourdomain.com"
CORS_CREDENTIALS=true

# Security Headers
ENABLE_SECURITY_HEADERS=true
ENABLE_CSRF_PROTECTION=true

# -----------------------------------------------------------------------------
# Monitoring & Analytics
# -----------------------------------------------------------------------------
# Error Tracking (Sentry)
# SENTRY_DSN="your-sentry-dsn"
# SENTRY_ENVIRONMENT="development"
# SENTRY_ENABLED=false

# Analytics
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX" # Google Analytics
# NEXT_PUBLIC_POSTHOG_KEY="phc_..." # PostHog
# ANALYTICS_ENABLED=false

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_AI_MATCHING=true
FEATURE_LINKEDIN_IMPORT=false
FEATURE_BULK_EMAIL=true
FEATURE_ADVANCED_REPORTS=true
FEATURE_CUSTOM_WORKFLOWS=true
FEATURE_API_ACCESS=true
FEATURE_WEBHOOKS=true

# -----------------------------------------------------------------------------
# Caching Configuration
# -----------------------------------------------------------------------------
# Redis (for production caching)
# REDIS_URL="redis://localhost:6379"
# REDIS_PASSWORD="your-redis-password"
# REDIS_ENABLED=false

# Cache TTL (in seconds)
CACHE_TTL_SHORT=300 # 5 minutes
CACHE_TTL_MEDIUM=3600 # 1 hour
CACHE_TTL_LONG=86400 # 24 hours

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL="info" # Options: "error", "warn", "info", "debug"
LOG_FORMAT="json" # Options: "json", "pretty"
LOG_FILE_ENABLED=false
LOG_FILE_PATH="./logs/app.log"

# -----------------------------------------------------------------------------
# Job Queue Configuration (Bull/BullMQ)
# -----------------------------------------------------------------------------
# QUEUE_REDIS_URL="redis://localhost:6379"
# QUEUE_ENABLED=false
# QUEUE_CONCURRENCY=5

# -----------------------------------------------------------------------------
# Webhook Configuration
# -----------------------------------------------------------------------------
WEBHOOK_SECRET="your-webhook-secret"
WEBHOOK_TIMEOUT=5000 # 5 seconds
WEBHOOK_RETRY_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Multi-tenancy Configuration
# -----------------------------------------------------------------------------
MULTI_TENANT_ENABLED=true
TENANT_ISOLATION_LEVEL="database" # Options: "database", "schema", "row"
DEFAULT_TENANT_PLAN="starter"

# -----------------------------------------------------------------------------
# Backup & Maintenance
# -----------------------------------------------------------------------------
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *" # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
MAINTENANCE_MODE=false

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
# Only in development
NEXT_PUBLIC_SHOW_DEBUG_INFO=false
ENABLE_SOURCE_MAPS=true
DISABLE_CACHE=false
