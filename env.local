# ============================================================================
# DATABASE - SUPABASE (REQUIRED)
# ============================================================================

# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# AI PROVIDERS (AT LEAST ONE REQUIRED)
# ============================================================================

# OpenAI (Recommended for resume parsing)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Anthropic (Alternative/Fallback)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# Which provider to use as primary (openai or anthropic)
LLM_PROVIDER=openai

# Model selection per feature (for cost optimization)
LLM_MODEL_PARSING=gpt-4-turbo-preview        # Most accurate for resume parsing
LLM_MODEL_MATCHING=gpt-3.5-turbo             # Fast and cost-effective
LLM_MODEL_ANALYSIS=gpt-4-turbo-preview       # Accurate for job analysis

# LLM Parameters
LLM_MAX_TOKENS=4000                          # Maximum tokens per request
LLM_TEMPERATURE=0.7                          # Creativity (0-2, lower = more focused)

# Fallback configuration
LLM_FALLBACK_ENABLED=true                    # Use fallback if primary fails
LLM_FALLBACK_MODEL=gpt-3.5-turbo            # Fallback model

# Rate limiting (requests per hour per organization)
LLM_RATE_LIMIT_PER_ORG=100

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# App URL (used for redirects, webhooks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000    # Change to your domain in production
NEXT_PUBLIC_APP_NAME=TalentPulse             # Your company name

# Environment
NODE_ENV=development                          # production | development | test

# ============================================================================
# EMAIL (FOR NOTIFICATIONS) - OPTIONAL BUT RECOMMENDED
# ============================================================================

# Resend (Recommended)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@yourdomain.com

# SendGrid (Alternative)
# SENDGRID_API_KEY=SG...
# FROM_EMAIL=noreply@yourdomain.com

# ============================================================================
# FILE STORAGE & UPLOADS
# ============================================================================

# Maximum file size in MB
MAX_FILE_SIZE_MB=10

# Allowed file types for resume uploads
ALLOWED_FILE_TYPES=.pdf,.doc,.docx

# Maximum bulk upload files
MAX_BULK_UPLOAD_FILES=50

# ============================================================================
# RATE LIMITING
# ============================================================================

# General API rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# AI-specific rate limiting
RATE_LIMIT_AI_REQUESTS_PER_HOUR=100
RATE_LIMIT_AI_REQUESTS_PER_DAY=500

# ============================================================================
# PAYMENTS & SUBSCRIPTIONS (PHASE 2) - OPTIONAL
# ============================================================================

# Stripe
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ============================================================================
# EXTERNAL INTEGRATIONS (PHASE 3) - OPTIONAL
# ============================================================================

# LinkedIn Integration (requires partnership)
# LINKEDIN_CLIENT_ID=...
# LINKEDIN_CLIENT_SECRET=...

# Job Board APIs
# INDEED_API_KEY=...
# LINKEDIN_JOBS_API_KEY=...

# Calendar Integration
# GOOGLE_CALENDAR_CLIENT_ID=...
# GOOGLE_CALENDAR_CLIENT_SECRET=...

# Slack Integration
# SLACK_WEBHOOK_URL=...
# SLACK_BOT_TOKEN=...

# ============================================================================
# MONITORING & LOGGING (PRODUCTION) - OPTIONAL
# ============================================================================

# Sentry (Error tracking)
# NEXT_PUBLIC_SENTRY_DSN=...

# PostHog (Analytics)
# NEXT_PUBLIC_POSTHOG_KEY=...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=...

# ============================================================================
# SECURITY
# ============================================================================

# Session secret (generate random string)
NEXTAUTH_SECRET=your-super-secret-key-here    # Generate with: openssl rand -base64 32

# Allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================================================
# DATABASE BACKUP (OPTIONAL)
# ============================================================================

# Backup configuration
# BACKUP_ENABLED=true
# BACKUP_FREQUENCY=daily
# BACKUP_RETENTION_DAYS=30

# ============================================================================
# FEATURE FLAGS (OPTIONAL)
# ============================================================================

# Enable/disable features
FEATURE_BULK_IMPORT=true
FEATURE_EXTERNAL_SEARCH=false
FEATURE_JOB_BOARD_POSTING=false
FEATURE_AI_MATCHING=true
FEATURE_REPORTS=true

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Debug mode (shows detailed errors)
DEBUG_MODE=true

# Mock AI responses (for testing without API calls)
MOCK_AI_RESPONSES=false

# Skip email verification (for testing)
SKIP_EMAIL_VERIFICATION=false